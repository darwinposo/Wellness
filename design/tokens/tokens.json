{
  "$schema": "https://tr.designtokens.org/format/",
  "description": "Reflect Design System — W3C Design Tokens format (Figma Variables reference)",

  "primitives": {
    "$description": "Raw values — map 1:1 to Figma Primitives collection",

    "color-amber-400":   { "$type": "color", "$value": "#D4724A", "oklch": "oklch(72% 0.15 45)",  "$description": "Brand warm — terracotta orange" },
    "color-teal-500":    { "$type": "color", "$value": "#4A7D8C", "oklch": "oklch(65% 0.10 230)", "$description": "Brand calm — muted teal" },
    "color-sage-400":    { "$type": "color", "$value": "#7DB87A", "oklch": "oklch(78% 0.14 130)", "$description": "Mood positive — soft sage green" },
    "color-coral-400":   { "$type": "color", "$value": "#C4735A", "oklch": "oklch(72% 0.12 35)",  "$description": "Mood negative — muted coral" },
    "color-neutral-950": { "$type": "color", "$value": "#1A1A22", "oklch": "oklch(20% 0.02 260)", "$description": "Text primary — near black" },
    "color-neutral-500": { "$type": "color", "$value": "#6E6E7E", "oklch": "oklch(55% 0.02 260)", "$description": "Text muted — mid gray" },
    "color-neutral-200": { "$type": "color", "$value": "#E2E2E8", "oklch": "oklch(90% 0.01 260)", "$description": "Border / divider" },
    "color-warm-50":     { "$type": "color", "$value": "#FAF8F5", "oklch": "oklch(97% 0.01 80)",  "$description": "Background primary — warm off-white" },
    "color-white":       { "$type": "color", "$value": "#FFFFFF", "oklch": "oklch(100% 0 0)",     "$description": "Surface / cards" },
    "color-overlay":     { "$type": "color", "$value": "#1A1A2280",                               "$description": "Modal scrim — 50% neutral-950" },
    "color-error":       { "$type": "color", "$value": "#D94F4F", "oklch": "oklch(62% 0.18 20)",  "$description": "Error state" },
    "color-success":     { "$type": "color", "$value": "#3D9A5C", "oklch": "oklch(65% 0.14 150)", "$description": "Success state" },

    "color-amber-300":   { "$type": "color", "$value": "#E89A70", "$description": "Brand warm light — hover / dark mode brand" },
    "color-teal-400":    { "$type": "color", "$value": "#6AA8B8", "$description": "Brand calm light — dark mode brand secondary" },
    "color-neutral-800": { "$type": "color", "$value": "#2A2A35", "$description": "Dark surface / card dark mode" },
    "color-neutral-900": { "$type": "color", "$value": "#1A1A28", "$description": "Dark background primary" }
  },

  "semantic": {
    "$description": "Semantic roles — map to primitives. Two modes: Light, Dark",

    "bg": {
      "primary":   { "light": "{primitives.color-warm-50}",     "dark": "{primitives.color-neutral-900}" },
      "secondary": { "light": "{primitives.color-white}",       "dark": "{primitives.color-neutral-800}" }
    },
    "surface": {
      "default":   { "light": "{primitives.color-white}",       "dark": "{primitives.color-neutral-800}" },
      "overlay":   { "light": "{primitives.color-overlay}",     "dark": "{primitives.color-overlay}" }
    },
    "brand": {
      "primary":   { "light": "{primitives.color-amber-400}",   "dark": "{primitives.color-amber-300}" },
      "secondary": { "light": "{primitives.color-teal-500}",    "dark": "{primitives.color-teal-400}" }
    },
    "mood": {
      "positive":  { "light": "{primitives.color-sage-400}",    "dark": "{primitives.color-sage-400}" },
      "negative":  { "light": "{primitives.color-coral-400}",   "dark": "{primitives.color-coral-400}" }
    },
    "text": {
      "primary":   { "light": "{primitives.color-neutral-950}", "dark": "{primitives.color-white}" },
      "muted":     { "light": "{primitives.color-neutral-500}", "dark": "{primitives.color-neutral-200}" }
    },
    "border":      { "light": "{primitives.color-neutral-200}", "dark": "{primitives.color-neutral-800}" },
    "error":       { "light": "{primitives.color-error}",       "dark": "{primitives.color-error}" },
    "success":     { "light": "{primitives.color-success}",     "dark": "{primitives.color-success}" }
  },

  "spacing": {
    "$description": "Spacing scale — Figma Variables > Spacing collection. Unit: px",
    "space-4":  { "$type": "dimension", "$value": "4px" },
    "space-8":  { "$type": "dimension", "$value": "8px" },
    "space-12": { "$type": "dimension", "$value": "12px" },
    "space-16": { "$type": "dimension", "$value": "16px" },
    "space-20": { "$type": "dimension", "$value": "20px" },
    "space-24": { "$type": "dimension", "$value": "24px", "$description": "Outer screen padding" },
    "space-32": { "$type": "dimension", "$value": "32px" },
    "space-48": { "$type": "dimension", "$value": "48px" },
    "space-64": { "$type": "dimension", "$value": "64px" },
    "space-card-padding": { "$type": "dimension", "$value": "16px", "$description": "Card internal padding" },
    "space-card-radius":  { "$type": "dimension", "$value": "16px", "$description": "Card border radius" }
  },

  "typography": {
    "$description": "Text styles — Figma Text Styles panel. 5 required styles.",

    "display": {
      "fontFamily":  "Plus Jakarta Sans",
      "fontWeight":  700,
      "fontSize":    "32px",
      "lineHeight":  "1.2",
      "$description": "Display — hero text, onboarding headlines"
    },
    "title": {
      "fontFamily":  "Plus Jakarta Sans",
      "fontWeight":  600,
      "fontSize":    "24px",
      "lineHeight":  "1.3",
      "$description": "Title — section headers, modal titles"
    },
    "body": {
      "fontFamily":  "Plus Jakarta Sans",
      "fontWeight":  400,
      "fontSize":    "16px",
      "lineHeight":  "1.6",
      "$description": "Body — standard UI copy"
    },
    "caption": {
      "fontFamily":  "Plus Jakarta Sans",
      "fontWeight":  400,
      "fontSize":    "13px",
      "lineHeight":  "1.4",
      "$description": "Caption — labels, timestamps, metadata"
    },
    "journal-body": {
      "fontFamily":  "Lora",
      "fontWeight":  400,
      "fontSize":    "18px",
      "lineHeight":  "1.8",
      "$description": "Journal Body — journaling text areas only (Lora serif)"
    }
  }
}
