  <button class="demo-btn" data-screen="screen-profile" onclick="showScreen('screen-profile')">Profil</button>
  <button class="demo-btn" data-screen="screen-settings" onclick="showScreen('screen-settings')">Notif</button>
</div>

<script>
  // Screens that show the tab bar
  var tabScreens = ['screen-home','screen-journal-list','screen-insights','screen-profile'];
  // Map screens to which tab is active
  var screenToTab = {
    'screen-home': 'tab-home',
    'screen-journal-list': 'tab-journal',
    'screen-insights': 'tab-insights',
    'screen-profile': 'tab-profile'
  };

  function showScreen(id) {
    // Hide all screens
    document.querySelectorAll('.screen').forEach(function(s) { s.classList.remove('active'); });
    var el = document.getElementById(id);
    if (el) {
      el.classList.add('active');
      el.scrollTop = 0;
    }

    // Tab bar visibility
    var tabBar = document.getElementById('main-tab-bar');
    if (tabScreens.indexOf(id) !== -1) {
      tabBar.style.display = 'flex';
    } else {
      tabBar.style.display = 'none';
    }

    // Update active tab
    document.querySelectorAll('.tab-item').forEach(function(t) { t.classList.remove('active'); });
    var tabId = screenToTab[id];
    if (tabId) {
      document.querySelectorAll('.tab-item').forEach(function(t) {
        if (t.getAttribute('data-tab') === tabId) t.classList.add('active');
      });
    }

    // Update demo nav
    document.querySelectorAll('.demo-btn').forEach(function(b) { b.classList.remove('active-screen'); });
    document.querySelectorAll('.demo-btn').forEach(function(b) {
      if (b.getAttribute('data-screen') === id) b.classList.add('active-screen');
    });

    // Home indicator visibility on dark screens
    var indicator = document.querySelector('.home-indicator');
    if (id === 'screen-welcome') {
      indicator.style.background = '#FFFFFF';
      indicator.style.opacity = '0.25';
    } else {
      indicator.style.background = 'var(--text-primary)';
      indicator.style.opacity = '0.18';
    }
  }

  function selectMood(el) {
    document.querySelectorAll('.mood-scale-item').forEach(function(i) { i.classList.remove('selected'); });
    el.classList.add('selected');
  }

  function toggleTag(el) {
    el.classList.toggle('selected');
  }

  function selectOb2Card(el) {
    document.querySelectorAll('.ob-select-card').forEach(function(c) { c.classList.remove('selected'); });
    el.classList.add('selected');
  }

  function selectOb3(el) {
    document.querySelectorAll('.ob-option-pill').forEach(function(c) { c.classList.remove('selected'); });
    el.classList.add('selected');
  }

  function selectOb4(el) {
    document.querySelectorAll('.ob-time-card').forEach(function(c) { c.classList.remove('selected'); });
    el.classList.add('selected');
  }

  // Start with welcome screen
  showScreen('screen-welcome');
</script>
</body>
</html>
